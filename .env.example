# Copy to .env only when you want to change defaults.
KFM_HOST=127.0.0.1
KFM_PORT=8765
KFM_MAX_UPLOAD_MB=128

# Optional. Leave empty until a local video-analysis wrapper is ready.
# This is the wrapper endpoint, NOT Ollama's /api/chat endpoint.
KFM_ANALYZER_URL=
KFM_MODEL_NAME=

# Built-in experimental local observer, after installing its local runtime:
# KFM_ANALYZER=ollama
# KFM_OLLAMA_MODEL=qwen3-vl:2b-instruct
# KFM_OLLAMA_URL=http://127.0.0.1:11434
# Alternative tested implementations: refined, objects, sequence.
# Match KFM_OLLAMA_MODEL to the installed model; see QUALITY_REPORT.md
# for measured results and the active configuration on this computer.
# DINO-guided analysis is experimental and intentionally inactive.

# Experimental 8B: synthetic loading was stopped by the memory monitor here.
# Its recognition accuracy is untested; it is not ready for regular use here.
# Set both lines together only when explicitly switching to this candidate:
# KFM_ANALYZER=large
# KFM_OLLAMA_MODEL=qwen3-vl:8b-instruct
# Uses num_batch=128 and releases the model after each video.
# Fresh model loading counts against each video's processing deadline.

# Optional: otherwise generated in data/api_key.txt.
KFM_API_KEY=
